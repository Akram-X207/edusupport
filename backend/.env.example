# Environment Configuration
# Copy this file to .env and fill in values

# Application
APP_NAME=EduSupport
APP_VERSION=1.0.0
DEBUG=true

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL=sqlite:///./edusupport.db

# CORS - comma-separated origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Risk Engine Thresholds
LOW_RISK_MAX=29
MEDIUM_RISK_MAX=59
# HIGH_RISK: 60-100

# Risk Weights (must sum to 100)
ATTENDANCE_WEIGHT=40
MARKS_WEIGHT=35
ASSIGNMENT_WEIGHT=25

# Attendance Threshold
MIN_ATTENDANCE_PERCENT=75

# First Run - seed demo data (set to false after first run)
SEED_ON_STARTUP=true
